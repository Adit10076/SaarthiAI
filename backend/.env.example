# Groq LLM
GROQ_API_KEY=your_groq_api_key

# LlamaParse document parser
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# Hugging Face — fine-grained token with "Make calls to Inference Providers" enabled
# Create at: https://huggingface.co/settings/tokens/new?tokenType=fineGrained
HF_TOKEN=your_huggingface_token

# Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=saarthi_docs

# Hybrid retrieval settings
RETRIEVAL_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
